<Application x:Class="PhantomHeroes.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!-- ============ Color palette ============ -->
            <Color x:Key="BgBase">#FF0B0F1A</Color>
            <Color x:Key="BgPanel">#FF141A2A</Color>
            <Color x:Key="BgPanelHi">#FF1B2338</Color>
            <Color x:Key="BgHover">#FF232C46</Color>
            <Color x:Key="Border">#FF2A344F</Color>
            <Color x:Key="BorderHi">#FF3C4A6E</Color>

            <Color x:Key="TextPrimary">#FFEAF0FA</Color>
            <Color x:Key="TextSecondary">#FF8B98B4</Color>
            <Color x:Key="TextDim">#FF5B6684</Color>

            <Color x:Key="AccentGlow">#FF7B5FFF</Color>
            <Color x:Key="AccentGlowHi">#FF9B85FF</Color>
            <Color x:Key="Success">#FF3DDC97</Color>
            <Color x:Key="Warn">#FFFFB454</Color>
            <Color x:Key="Danger">#FFFF5B7E</Color>

            <SolidColorBrush x:Key="BgBaseBrush"    Color="{StaticResource BgBase}"/>
            <SolidColorBrush x:Key="BgPanelBrush"   Color="{StaticResource BgPanel}"/>
            <SolidColorBrush x:Key="BgPanelHiBrush" Color="{StaticResource BgPanelHi}"/>
            <SolidColorBrush x:Key="BgHoverBrush"   Color="{StaticResource BgHover}"/>
            <SolidColorBrush x:Key="BorderBrush"    Color="{StaticResource Border}"/>
            <SolidColorBrush x:Key="BorderHiBrush"  Color="{StaticResource BorderHi}"/>

            <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
            <SolidColorBrush x:Key="TextDimBrush"       Color="{StaticResource TextDim}"/>

            <SolidColorBrush x:Key="AccentBrush"   Color="{StaticResource AccentGlow}"/>
            <SolidColorBrush x:Key="AccentHiBrush" Color="{StaticResource AccentGlowHi}"/>
            <SolidColorBrush x:Key="SuccessBrush"  Color="{StaticResource Success}"/>
            <SolidColorBrush x:Key="WarnBrush"     Color="{StaticResource Warn}"/>
            <SolidColorBrush x:Key="DangerBrush"   Color="{StaticResource Danger}"/>

            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF7B5FFF" Offset="0"/>
                <GradientStop Color="#FFD05FFF" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="AccentGradientHover" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF9575FF" Offset="0"/>
                <GradientStop Color="#FFE075FF" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF1B1F35" Offset="0"/>
                <GradientStop Color="#FF261B44" Offset="0.6"/>
                <GradientStop Color="#FF1B1F35" Offset="1"/>
            </LinearGradientBrush>

            <!-- ============ Typography ============ -->
            <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI, Inter, Arial</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

            <!-- ============ Base defaults ============ -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>

            <!-- Rounded borderless textbox -->
            <Style TargetType="TextBox" x:Key="ModernTextBox">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Background" Value="{StaticResource BgPanelHiBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,10"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHiBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHiBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Big accent button -->
            <Style TargetType="Button" x:Key="AccentButton">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#7B5FFF" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGradientHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGradient}"/>
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Neutral secondary button -->
            <Style TargetType="Button" x:Key="SubtleButton">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Padding" Value="20,12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="Background" Value="{StaticResource BgPanelHiBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderHiBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Danger button -->
            <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource SubtleButton}">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                <Setter Property="BorderBrush" Value="#553D4E"/>
            </Style>

            <!-- Card / panel container -->
            <Style TargetType="Border" x:Key="Card">
                <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="22"/>
            </Style>

            <Style TargetType="ScrollViewer" x:Key="ThinScroll">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
