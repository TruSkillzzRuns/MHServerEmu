<Window x:Class="PhantomHeroes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phantom Heroes"
        Width="1080" Height="720"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBaseBrush}"
        FontFamily="{StaticResource UiFont}"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <!-- Deep-black base so the hex artwork has something to sit on and
             cards read cleanly even in transparent regions. -->
        <Rectangle Fill="{StaticResource BgBaseBrush}"/>
        <!-- Hex-mesh background image, held at 55 % opacity so it reads as
             ambient texture rather than dominant art. UniformToFill keeps it
             full-bleed at any window aspect ratio. -->
        <Rectangle Opacity="0.55">
            <Rectangle.Fill>
                <ImageBrush ImageSource="pack://application:,,,/Assets/background.jpeg"
                            Stretch="UniformToFill"/>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Legacy purple hero-gradient wash on top of the hex, softened so
             the artwork still shows through. Preserves the brand tint. -->
        <Rectangle Fill="{StaticResource HeroGradient}" Opacity="0.35"/>
        <!-- Big soft accent glow behind top-left -->
        <Ellipse Width="700" Height="700"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-260,-260,0,0"
                 Opacity="0.35">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#FF7B5FFF" Offset="0"/>
                    <GradientStop Color="#007B5FFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <!-- Second glow bottom-right -->
        <Ellipse Width="600" Height="600"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-220,-220"
                 Opacity="0.28">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#FFD05FFF" Offset="0"/>
                    <GradientStop Color="#00D05FFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Margin="32,28,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ Header ============ -->
            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo mark — real artwork replaces the old PH monogram. -->
                <Border Grid.Column="0"
                        Width="64" Height="64"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#7B5FFF" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/>
                    </Border.Effect>
                    <Image Source="pack://application:,,,/Assets/logo.jpeg"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Phantom Heroes"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Add server-side hero NPCs to your MHServerEmu install"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Background="{StaticResource BgPanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChipVersion"
                                   Text="Ready"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="8,0,4,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Source path picker ============ -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                               Text="MHServerEmu source folder"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,10"/>
                    <TextBox Grid.Row="1" Grid.Column="0"
                             x:Name="SourceBox"
                             Style="{StaticResource ModernTextBox}"
                             TextChanged="SourceBox_TextChanged"/>
                    <Button Grid.Row="1" Grid.Column="1"
                            Style="{StaticResource SubtleButton}"
                            Margin="10,0,0,0"
                            Content="Browse..."
                            Click="Browse_Click"/>
                    <Button Grid.Row="1" Grid.Column="2"
                            Style="{StaticResource AccentButton}"
                            Margin="10,0,0,0"
                            x:Name="DetectButton"
                            Content="Detect"
                            Click="Detect_Click"/>
                </Grid>
            </Border>

            <!-- ============ Detection findings ============ -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Detected server code generation"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   ToolTip="This is the MHServerEmu server-code generation, NOT the game client version. Both generations can target either client — Modern with phantom-Player is more common."/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="DetectedVersionText"
                                       Text="—"
                                       FontSize="22"
                                       FontWeight="SemiBold"/>
                            <Border x:Name="StatusBadge"
                                    Background="#33FFB454"
                                    CornerRadius="8"
                                    Padding="10,4"
                                    VerticalAlignment="Center"
                                    Margin="14,0,0,0">
                                <TextBlock x:Name="StatusBadgeText"
                                           Text="Awaiting scan"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WarnBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                        <Border Background="{StaticResource BgPanelHiBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Modern signal"
                                           FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"
                                           ToolTip="IsMovementAuthoritative override on Avatar — modern MHServerEmu codebase, uses the phantom-Player recipe."/>
                                <TextBlock x:Name="Signal153"
                                           Text="—"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgPanelHiBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Legacy signal"
                                           FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"
                                           ToolTip="Agent.ClientPrototypeRefOverride — pre-refactor MHServerEmu, uses the simpler render-override recipe."/>
                                <TextBlock x:Name="Signal152"
                                           Text="—"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- File checklist -->
                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="2"
                                  x:Name="FileChecklist"
                                  Margin="0,16,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgPanelHiBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,6"
                                        Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Symbol}"
                                                   Foreground="{Binding Brush}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <!-- ============ Log output ============ -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock Text="Activity"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text=" · "
                                   FontSize="12"
                                   Foreground="{StaticResource TextDimBrush}"/>
                        <TextBlock x:Name="LogSummary"
                                   Text="Idle"
                                   FontSize="12"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#FF0A0E18"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,10,0,0">
                        <ScrollViewer x:Name="LogScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto">
                            <TextBox x:Name="LogBox"
                                     Text=""
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="12"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     SelectionBrush="{StaticResource AccentBrush}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- ============ Runtime controls (hits POST /webapi/phantom/*) ============ -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Runtime — control phantoms on a running server"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="Requires the server to be running with the phantom web handler installed and a player online. Server URL defaults to http://localhost — change if your WebFrontend is elsewhere."
                               FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Server URL:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox   Grid.Column="1" x:Name="ServerUrlBox" Text="http://localhost:8080" Style="{StaticResource ModernTextBox}" Margin="10,0,0,0"
                                   ToolTip="MHServerEmu WebFrontend URL. Defaults to port 8080 to bypass any Apache reverse-proxy in front (Apache typically only forwards known paths)."/>
                        <TextBlock Grid.Column="2" Text="Count:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0"/>
                        <TextBox   Grid.Column="3" x:Name="RuntimeCountBox" Text="10" Style="{StaticResource ModernTextBox}"/>
                        <TextBlock Grid.Column="4" Text="Level:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="10,0,0,0"/>
                        <TextBox   Grid.Column="5" x:Name="RuntimeLevelBox" Text="60" Style="{StaticResource ModernTextBox}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource AccentButton}" Content="Spawn phantoms" Click="Runtime_Spawn_Click"/>
                        <Button Style="{StaticResource SubtleButton}" Margin="10,0,0,0" Content="Clear phantoms" Click="Runtime_Clear_Click"/>
                        <Button Style="{StaticResource SubtleButton}" Margin="10,0,0,0" Content="Status" Click="Runtime_Status_Click"/>
                        <TextBlock x:Name="RuntimeStatusText" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ Action row ============ -->
            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <CheckBox x:Name="DryRunToggle"
                              Content="Dry run (no files changed)"
                              IsChecked="True"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              VerticalAlignment="Center"/>
                    <CheckBox x:Name="RebuildToggle"
                              Content="Rebuild server after install"
                              IsChecked="True"
                              Foreground="{StaticResource TextSecondaryBrush}"
                              Margin="0,6,0,0"
                              VerticalAlignment="Center"
                              ToolTip="Runs 'dotnet build MHServerEmu.sln -c Release' after a successful install. Requires .NET 8 SDK on your machine."/>
                </StackPanel>

                <Button Grid.Column="2"
                        Style="{StaticResource DangerButton}"
                        x:Name="UninstallButton"
                        Content="Uninstall"
                        IsEnabled="False"
                        Click="Uninstall_Click"/>
                <Button Grid.Column="3"
                        Style="{StaticResource SubtleButton}"
                        Margin="10,0,0,0"
                        x:Name="ClearLogButton"
                        Content="Clear log"
                        Click="ClearLog_Click"/>
                <Button Grid.Column="4"
                        Style="{StaticResource AccentButton}"
                        Margin="10,0,0,0"
                        x:Name="InstallButton"
                        Content="Install phantom heroes"
                        IsEnabled="False"
                        Click="Install_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
